<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Bakery — Shop</title>

  <!-- Google font (online) -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet">

  <style>
    :root{
      --bg:#fff7f7;
      --accent:#d6b79a;
      --accent-dark:#caa87a;
      --muted:#f8ebe9;
      --text:#222;
      --green:#2fb76f;
      --pink:#f7e9e7;
      --button-radius:20px;
      --container:1100px;
    }
    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
      background:var(--bg);
      color:var(--text);
      -webkit-font-smoothing:antialiased;
    }

    /* Top promo bar */
    .topbar{
      background:#fff;
      border-bottom:1px solid rgba(0,0,0,0.06);
      font-size:13px;
      color:#666;
      padding:8px 0;
    }
    .topbar .wrap{
      max-width:var(--container);
      margin:0 auto;
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:10px;
      padding:0 16px;
    }
    .promo{font-weight:600}
    .phone{color:#2fb76f; font-weight:600}

    /* Header */
    header{
      background:linear-gradient(180deg, #fff,#fff);
      padding:18px 0;
      border-bottom:1px solid rgba(0,0,0,0.03);
    }
    .header-inner{
      max-width:var(--container);
      margin:0 auto;
      display:flex;
      align-items:center;
      gap:20px;
      padding:0 16px;
    }
    .logo{
      display:flex;
      align-items:center;
      gap:12px;
      flex:0 0 160px;
    }
    .logo img{width:64px;height:64px;border-radius:50%;object-fit:cover;border:6px solid #fff;}
    .logo .name{font-family:"Playfair Display", serif;color:var(--accent-dark);font-size:22px;font-weight:700}

    /* search */
    .search{
      flex:1;
      display:flex;
      justify-content:center;
    }
    .search .box{
      width:460px;
      max-width:100%;
      display:flex;
      align-items:center;
      gap:8px;
      background:var(--muted);
      padding:8px 12px;
      border-radius:999px;
      border:1px solid rgba(0,0,0,0.06);
    }
    .search input{
      border:0;background:transparent;outline:none;font-size:15px;padding:6px 8px;width:100%;
    }
    .search button{
      border:0;background:var(--accent);color:#fff;padding:8px 12px;border-radius:999px;font-weight:600;cursor:pointer;
    }

    /* nav & user icons */
    nav{display:flex;gap:18px;align-items:center;padding:12px 16px;background:transparent; max-width:var(--container); margin:0 auto;}
    nav a{color:#444;text-decoration:none;font-size:15px; padding:6px 8px}
    .user-actions{margin-left:auto;display:flex;gap:14px;align-items:center}
    .user-actions img{width:36px;height:36px;border-radius:50%;object-fit:cover;border:2px solid #fff}

    /* main content */
    .container{
      max-width:var(--container);
      margin:18px auto;
      padding:0 16px 56px;
    }

    .table-card{
      background:linear-gradient(180deg, #fff, #fff);
      border-radius:10px;
      padding:18px;
      box-shadow:0 6px 14px rgba(0,0,0,0.03);
      border:1px solid rgba(0,0,0,0.04);
    }

    .table-head{
      display:grid;
      grid-template-columns: 120px 1fr 140px 160px 140px;
      gap:12px;
      align-items:center;
      padding:12px;
      background:var(--accent);
      color:#6a4d33;
      border-radius:8px;
      font-weight:600;
    }

    .product-row{
      display:grid;
      grid-template-columns:120px 1fr 140px 160px 140px;
      gap:12px;
      align-items:center;
      padding:18px 12px;
      border-bottom:1px dashed rgba(0,0,0,0.03);
      background:linear-gradient(180deg, #fff, #fff7f7);
    }
    .product-thumb img{width:100px;height:100px;object-fit:cover;border-radius:8px;border:1px solid rgba(0,0,0,0.03)}
    .product-name{font-weight:600;color:#222}
    .price{color:var(--green); font-weight:700}
    .stock{color:var(--green); font-weight:700}

    .btn{
      display:inline-block;
      border:0;
      padding:10px 18px;
      border-radius:20px;
      cursor:pointer;
      font-weight:600;
    }
    .btn-add{background:var(--accent-dark); color:#fff}
    .btn-wishlist{background:#fff;border:1px solid rgba(0,0,0,0.06); color:#c34a4a}

    .wishlist-row{
      display:flex;
      align-items:center;
      gap:12px;
      margin-top:18px;
      flex-wrap:wrap;
    }
    .link-input{
      display:flex;
      gap:8px;
      align-items:center;
    }
    .link-input input{
      padding:10px 12px;border-radius:999px;border:1px solid rgba(0,0,0,0.08);min-width:240px;
    }
    .small-btn{padding:8px 12px;border-radius:14px;border:0;background:var(--accent);color:#fff;font-weight:600;cursor:pointer}

    /* footer */
    footer{
      margin-top:36px;
      background:#fff;
      padding:28px 0 40px;
      border-top:1px solid rgba(0,0,0,0.03);
    }
    .footer-inner{
      max-width:var(--container);
      margin:0 auto;
      display:grid;
      grid-template-columns:150px 1fr 1fr 1fr;
      gap:20px;
      align-items:start;
      padding:0 16px;
    }
    .footer-logo img{width:96px;height:96px;border-radius:50%;}
    .footer-col h4{margin:0 0 12px;font-size:15px;color:#333}
    .footer-col ul{list-style:none;padding:0;margin:0;line-height:2}
    .footer-col a{color:#444;text-decoration:none;font-size:14px}

    .copyright{max-width:var(--container);margin:18px auto 60px;padding:0 16px;color:#888;font-size:13px;text-align:center}

    /* responsive */
    @media (max-width:900px){
      .table-head, .product-row{grid-template-columns: 80px 1fr 100px 120px 100px}
      .logo{flex:0 0 120px}
    }
    @media (max-width:680px){
      nav{display:none}
      .header-inner{flex-wrap:wrap;gap:12px}
      .product-row, .table-head{grid-template-columns: 80px 1fr; grid-auto-rows:auto}
      .product-row > *{padding:6px 0}
      .product-row .price, .product-row .date, .product-row .stock, .product-row .actions{grid-column:1/3}
      .table-head{display:none}
      .footer-inner{grid-template-columns:1fr 1fr;gap:14px}
    }
  </style>
</head>
<body>

  <!-- Topbar -->
  <div class="topbar">
    <div class="wrap">
      <div class="promo">Free Deliver Above 999 — Get 25% OFF for first order</div>
      <div class="phone">Call: 123-456-789</div>
    </div>
  </div>

  <!-- Header -->
  <header>
    <div class="header-inner">
      <div class="logo">
        <img src="images/logo.png" alt="Bakery logo" />
        <div>
          <div class="name">Bakery</div>
          <div style="font-size:12px;color:#8b6f5b">Fresh & Tasty</div>
        </div>
      </div>

      <div class="search">
        <div class="box">
          <input id="searchInput" placeholder="Search product" type="text" />
          <button id="searchBtn">Search</button>
        </div>
      </div>

      <div class="user-actions">
        <img src="images/profile.png" alt="user" title="Profile" />
        <button class="btn" style="background:transparent;border:1px solid rgba(0,0,0,0.06);">❤</button>
        <button class="btn" style="background:transparent;border:1px solid rgba(0,0,0,0.06);">🛒 <span id="cartCount" style="font-weight:700;margin-left:6px">0</span></button>
      </div>
    </div>
  </header>

  <!-- Navigation -->
  <nav>
    <a href="#">Home</a>
    <a href="#">Shop</a>
    <a href="#">Categories</a>
    <a href="#">Gallery</a>
    <a href="#">Blog</a>
    <a href="#">Contact us</a>
  </nav>

  <!-- Main container -->
  <div class="container">
    <div class="table-card">
      <div class="table-head">
        <div>Product</div>
        <div>Names</div>
        <div>Price</div>
        <div>Date Added</div>
        <div>Stock Status</div>
      </div>

      <!-- Product Row 1 -->
      <div class="product-row" data-name="Birthday Browny Mac">
        <div class="product-thumb">
          <img src="images/birthday party.png" alt="cake" />
        </div>

        <div>
          <div class="product-name">Birthday Browny Mac</div>
          <div style="font-size:13px;color:#777;margin-top:6px">Delicious chocolate cake with decorations.</div>
        </div>

        <div class="price">₹850</div>

        <div class="date">22 August 2025</div>

        <div class="actions">
          <div class="stock">InStock</div>
          <div style="margin-top:8px">
            <button class="btn btn-add" onclick="addToCart('Birthday Browny Mac')">Add to Cart</button>
          </div>
        </div>
      </div>

      <!-- Wishlist row -->
      <div style="padding:18px 12px">
        <div class="wishlist-row">
          <div style="font-weight:600">Wishlist link</div>
          <div class="link-input">
            <input id="wishlistInput" value="http://example.com" />
            <button class="small-btn" id="copyBtn">Copy link</button>
            <button class="small-btn" id="clearWishlist" style="background:#fff;border:1px solid rgba(0,0,0,0.08);color:#d65b63">Clear Wishlist</button>
          </div>
          <div style="margin-left:auto">
            <button class="btn btn-add" onclick="addToCart('Wishlist item')">Add to Cart</button>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Footer -->
  <footer>
    <div class="footer-inner">
      <div class="footer-logo">
        <img src="images/logo.png" alt="Bakery" />
      </div>

      <div class="footer-col">
        <h4>Customer service</h4>
        <ul>
          <li><a href="#">My Account</a></li>
          <li><a href="#">Checkup</a></li>
          <li><a href="#">FAQ</a></li>
          <li><a href="#">Return</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Company</h4>
        <ul>
          <li><a href="#">About us</a></li>
          <li><a href="#">Blogs</a></li>
          <li><a href="#">Contact us</a></li>
          <li><a href="#">Career</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Our information</h4>
        <ul>
          <li><a href="#">Privacy</a></li>
          <li><a href="#">Terms & Condition</a></li>
          <li><a href="#">Customer Feed back</a></li>
          <li style="margin-top:8px;font-size:14px;color:#444">
            <div>Mobile: 123-456-789</div>
            <div>Email_Bakery@gmail.com</div>
            <div>Address : 12, north city-001</div>
          </li>
        </ul>
      </div>
    </div>

    <div class="copyright">
      © 2025 Bakery co. All rights reserved. — Terms & Conditions | Privacy Policy
    </div>
  </footer>

  <script>
    // Simple JS interactions
    const cartCountEl = document.getElementById('cartCount');

    function addToCart(name){
      // increment cart count
      const current = Number(cartCountEl.textContent || 0);
      cartCountEl.textContent = current + 1;
      // small toast
      showToast(`${name} added to cart`);
    }

    // copy wishlist link
    document.getElementById('copyBtn').addEventListener('click', async () => {
      const input = document.getElementById('wishlistInput');
      try {
        await navigator.clipboard.writeText(input.value);
        showToast('Wishlist link copied!');
      } catch (e){
        // fallback
        input.select();
        document.execCommand('copy');
        showToast('Copied (fallback)');
      }
    });

    // clear wishlist
    document.getElementById('clearWishlist').addEventListener('click', () => {
      document.getElementById('wishlistInput').value = '';
      showToast('Wishlist cleared');
    });

    // search
    document.getElementById('searchBtn').addEventListener('click', ()=>{
      const q = document.getElementById('searchInput').value.trim();
      showToast(q ? `Searching: ${q}` : 'Please type product name');
    });

    // simple toast
    function showToast(msg){
      const t = document.createElement('div');
      t.textContent = msg;
      t.style.position='fixed';
      t.style.bottom='22px';
      t.style.left='50%';
      t.style.transform='translateX(-50%)';
      t.style.background='rgba(0,0,0,0.8)';
      t.style.color='#fff';
      t.style.padding='10px 14px';
      t.style.borderRadius='10px';
      t.style.zIndex=9999;
      t.style.fontSize='14px';
      document.body.appendChild(t);
      setTimeout(()=>{ t.style.transition='opacity 300ms'; t.style.opacity=0; }, 1400);
      setTimeout(()=> t.remove(), 1800);
    }
  </script>
</body>
</html>
